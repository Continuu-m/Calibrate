DATABASE_URL=postgresql://user:password@host/dbname
SECRET_KEY=your_secret_key_here

# Email Settings (Using Mailtrap or similar fake SMTP for testing)
MAIL_USERNAME=fake_user
MAIL_PASSWORD=fake_password
MAIL_FROM=hello@calibrate.app
MAIL_PORT=2525
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Google OAuth Configuration
# The redirect URI is auto-computed as: {BACKEND_URL}/auth/google/callback
# You need to register this URL in Google Cloud Console OAuth Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# Optional: Override with explicit redirect URI if needed
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL for OAuth callbacks
FRONTEND_URL=http://localhost:5173

# AI Engine API Key
GROQ_API_KEY=gsk_your_key_here

# For development only - allows HTTP OAuth in non-HTTPS environments
OAUTHLIB_INSECURE_TRANSPORT=1

OAUTHLIB_INSECURE_TRANSPORT="1"
